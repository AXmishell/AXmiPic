# 复制为 .env 后按需修改；docker compose 会自动读取同目录下的 .env。
# 该文件可能包含敏感信息，请勿提交到版本库。

# 固定 JWT 密钥（留空则自动生成并持久化到 axmipic-data 卷）。
# 生产环境与多实例部署请设置为足够长的随机字符串。
AXMIPIC_JWT_SECRET=

# 可选：用环境变量覆盖站点地址（默认由安装向导写入配置；设置后优先级更高）。
# AXMIPIC_BASE_URL=http://localhost:8080

# 仅在非向导模式（AXMIPIC_INSTALL_DISABLED=true）下，用于首次创建管理员：
# AXMIPIC_ADMIN_PASSWORD=change-me-please
